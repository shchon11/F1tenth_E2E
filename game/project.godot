; TENTH — Godot 4 프런트엔드 (2026-11-28 스파이크 -> M1 레이스 화면)
; 이 파일은 에디터 없이 텍스트로 관리한다. 규약: docs/pm/sim-arch-2026-11-28/ARCHITECTURE.md §4

config_version=5

[application]

config/name="TENTH"
config/description="1/10 자율주행 레이싱 시뮬레이터 프런트엔드"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=false

[autoload]

App="*res://scripts/autoload/app.gd"
SimLink="*res://scripts/autoload/sim_link.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1200
window/size/window_width_override=1600
window/size/window_height_override=1000
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://theme/tenth_theme.tres"
theme/default_font_multichannel_signed_distance_field=false

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.027451, 0.031373, 0.031373, 1)
textures/canvas_textures/default_texture_filter=1
